<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img1_sp"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="100dp"
        android:contentDescription="@string/todo"
        android:src="@drawable/image2_sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt1_sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="@string/task_txt"
        android:textColor="@color/txt_black"
        android:textSize="38sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/img1_sp"
        app:layout_constraintHorizontal_bias="0.539"
        app:layout_constraintStart_toStartOf="@+id/img1_sp"
        app:layout_constraintTop_toBottomOf="@+id/img1_sp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txt2_sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/explain_txt"
        android:textColor="#1F1C43"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@+id/txt1_sp"
        app:layout_constraintStart_toStartOf="@+id/txt1_sp"
        app:layout_constraintTop_toBottomOf="@+id/txt1_sp" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img2_sp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/SP_image2"
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:src="@drawable/group_217"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt2_sp" />

</androidx.constraintlayout.widget.ConstraintLayout>